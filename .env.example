# Campus Marketplace Environment Variables Example
SECRET_KEY=replace-with-a-strong-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,your-app.onrender.com,localhost

# Database (Supabase PostgreSQL / Production)
# Direct or Session Pooler URI:
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Supabase Object Storage (S3 Protocol via django-storages[s3] & boto3)
# Target bucket: 'listing-images'
# SUPABASE_S3_ACCESS_KEY=your_supabase_s3_access_key
# SUPABASE_S3_SECRET_KEY=your_supabase_s3_secret_key
# SUPABASE_S3_BUCKET_NAME=listing-images
# SUPABASE_S3_ENDPOINT_URL=https://[PROJECT-REF].storage.supabase.co/v1/s3
# SUPABASE_S3_REGION_NAME=ap-southeast-2

# Email Verification via Gmail SMTP
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# DEFAULT_FROM_EMAIL=Campus Marketplace <your-email@gmail.com>

# Optional Cloudinary Fallback
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=



