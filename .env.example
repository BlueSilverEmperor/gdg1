# Campus Marketplace Environment Variables Configuration
# Production on Railway with Supabase PostgreSQL and Supabase S3 Object Storage

# Server & Runtime Configuration
PORT=8000
SECRET_KEY=replace-with-a-50-character-cryptographically-secure-production-key
DEBUG=False
ALLOWED_HOSTS=.railway.app,.up.railway.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://*.up.railway.app
SECURE_SSL_REDIRECT=True

# Database: Supabase PostgreSQL (via Transaction Pooler port 6543)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase S3 Object Storage (via django-storages[s3] & boto3)
SUPABASE_S3_ACCESS_KEY=your_supabase_s3_access_key_id
SUPABASE_S3_SECRET_KEY=your_supabase_s3_secret_access_key
SUPABASE_S3_BUCKET_NAME=listing_images
SUPABASE_S3_ENDPOINT_URL=https://[PROJECT-REF].supabase.co/storage/v1/s3
SUPABASE_S3_REGION_NAME=ap-southeast-2

# Email Verification (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=Campus Marketplace <your-email@gmail.com>

# Optional Cloudinary Fallback (if not using Supabase S3)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
